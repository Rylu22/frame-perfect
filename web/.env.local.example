# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — powers the Admin console (deleting accounts, entering
# testing-sandbox accounts). This key bypasses Row Level Security entirely.
# NEVER prefix it with NEXT_PUBLIC_ and never reference it from a "use
# client" file — it must only ever be read inside Server Actions / Route
# Handlers. From Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
